{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/index.html.md" },
    { "source": "/privacy.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/privacy.html.md" },
    { "source": "/whitepaper.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/whitepaper.html.md" },
    { "source": "/voice-control.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/voice-control.md" },
    { "source": "/browser-app-control.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/browser-app-control.md" },
    { "source": "/accessibility-hands-free.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/accessibility-hands-free.md" },
    { "source": "/gesture-gaze-control.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/gesture-gaze-control.md" },
    { "source": "/autonomous-workflows.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/autonomous-workflows.md" },
    { "source": "/plugin-marketplace.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/plugin-marketplace.md" },
    { "source": "/neural-research.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/neural-research.md" },
    { "source": "/heliox-vs-windows-copilot.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/heliox-vs-windows-copilot.md" },
    { "source": "/heliox-vs-open-interpreter.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/heliox-vs-open-interpreter.md" },
    { "source": "/heliox-vs-traditional-automation.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/heliox-vs-traditional-automation.md" },
    { "source": "/cost.html", "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }], "destination": "/cost.md" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Signal", "value": "search=yes, ai-input=yes, ai-train=no, use=reference" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</index.html.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/privacy.html",
      "headers": [
        {
          "key": "Link",
          "value": "</privacy.html.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/whitepaper.html",
      "headers": [
        {
          "key": "Link",
          "value": "</whitepaper.html.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/capabilities.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/releases.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" },
        { "key": "Link", "value": "</changelog.md>; rel=\"alternate\"; type=\"text/markdown\", </releases.feed.json>; rel=\"alternate\"; type=\"application/feed+json\", </releases.xml>; rel=\"alternate\"; type=\"application/rss+xml\"" }
      ]
    },
    {
      "source": "/releases.feed.json",
      "headers": [
        { "key": "Content-Type", "value": "application/feed+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    },
    {
      "source": "/releases.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    },
    {
      "source": "/visibility-(.*).json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600" }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/assets/scroll-world/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
